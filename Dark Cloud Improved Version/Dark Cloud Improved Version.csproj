<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Dark Cloud Enhanced Mod</AssemblyName>
    <RootNamespace>Dark_Cloud_Improved_Version</RootNamespace>
    <LangVersion>preview</LangVersion>
    <ApplicationIcon>ModIcon.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <PackageReference Include="MsBox.Avalonia" Version="3.0.0-rc2" />
    <PackageReference Include="System.Drawing.Common" Version="8.*" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.*" />
    <PackageReference Include="System.Resources.Extensions" Version="8.*" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- RubyMemeFix = extracted c05 game data from the UNTRACKED game_data/ folder. Every include below is
         guarded by Exists() so the build NEVER requires an untracked file: a clean checkout (no game_data/)
         builds fine and simply omits these assets. Present for local dev only; never redistributed. -->
    <EmbeddedResource Include="..\game_data\RubyMemeFix\Fire" Condition="Exists('..\game_data\RubyMemeFix\Fire')">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.RubyMemeFix.Fire</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\game_data\RubyMemeFix\Holy" Condition="Exists('..\game_data\RubyMemeFix\Holy')">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.RubyMemeFix.Holy</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\game_data\RubyMemeFix\Ice" Condition="Exists('..\game_data\RubyMemeFix\Ice')">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.RubyMemeFix.Ice</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\game_data\RubyMemeFix\Thunder" Condition="Exists('..\game_data\RubyMemeFix\Thunder')">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.RubyMemeFix.Thunder</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\game_data\RubyMemeFix\Wind" Condition="Exists('..\game_data\RubyMemeFix\Wind')">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.RubyMemeFix.Wind</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\Font\DarkCloud_Speech-Thin.ttf" />
    <!-- Town-camera collision/controller EE function (assembled from tools/town_camera_collision.s @0x14B838).
         IsoPatcher reads this at patch time; regenerate = reassemble + copy the .bin here + refresh slot indices. -->
    <EmbeddedResource Include="Resources\isoPatch\cameraHeight.bin">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.isoPatch.cameraHeight.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\isoPatch\townCameraCollision.bin">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.isoPatch.townCameraCollision.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\isoPatch\canalEvictFadeHook.bin">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.isoPatch.canalEvictFadeHook.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\isoPatch\queensSprayCave.bin">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.isoPatch.queensSprayCave.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\isoPatch\sprayBiasShim.bin">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.isoPatch.sprayBiasShim.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\isoPatch\capeEarlyDraw.bin">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.isoPatch.capeEarlyDraw.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\isoPatch\fishlineSplitCaves.bin">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.isoPatch.fishlineSplitCaves.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\isoPatch\fishlineUncastGate.bin">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.isoPatch.fishlineUncastGate.bin</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\PNACH\A5C05C78.pnach">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
    <None Include="Resources\FishingCollision\brownboo_14.bin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Queens fishing collision embeds ISO-derived bridge/pipe geometry, so it lives in the UNTRACKED
         game_data/ tree (built by tools/export_queens_collision.py) and is Linked in, guarded by Exists(). -->
    <None Include="..\game_data\queens\queens_2.bin" Condition="Exists('..\game_data\queens\queens_2.bin')">
      <Link>Resources\FishingCollision\queens_2.bin</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Extracted game assets from the UNTRACKED game_data/ folder. Guarded by Exists() so a clean checkout
         builds without them (these features degrade gracefully at runtime when the file is absent). Link
         keeps the output layout (Resources/Fish, Resources/Sign) so runtime load paths are unchanged. Never
         redistributed. f19a (Priscleen, from a DC2 disc) is pending a runtime-extraction path. -->
    <None Include="..\game_data\priscleen\f19a.chr" Condition="Exists('..\game_data\priscleen\f19a.chr')">
      <Link>Resources\Fish\f19a.chr</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\game_data\fishsign\fishsign.chr" Condition="Exists('..\game_data\fishsign\fishsign.chr')">
      <Link>Resources\Sign\fishsign.chr</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="ModIcon.ico" />
    <AvaloniaResource Include="Resources\d06o_out_result.png" />
  </ItemGroup>
</Project>
