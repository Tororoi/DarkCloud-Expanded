<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Dark Cloud Enhanced Mod</AssemblyName>
    <RootNamespace>Dark_Cloud_Improved_Version</RootNamespace>
    <LangVersion>preview</LangVersion>
    <ApplicationIcon>ModIcon.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <PackageReference Include="MsBox.Avalonia" Version="3.0.0-rc2" />
    <PackageReference Include="System.Drawing.Common" Version="8.*" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.*" />
    <PackageReference Include="System.Resources.Extensions" Version="8.*" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\Font\DarkCloud_Speech-Thin.ttf" />
    <!-- Town-camera collision/controller EE function (assembled from tools/town_camera_collision.s @0x14B838).
         IsoPatcher reads this at patch time; regenerate = reassemble + copy the .bin here + refresh slot indices. -->
    <!-- Every ISO-patch resource (Resources/isoPatch: stubs/<group>/, data/, assets/), embedded under its BARE file name — the name
         ElfCaveWriter.Embedded looks up — so the folders are only where a file lives on disk. Two files sharing a name would collide. -->
    <EmbeddedResource Include="Resources\isoPatch\**\*.bin;Resources\isoPatch\**\*.json;Resources\isoPatch\**\*.png">
      <LogicalName>Dark_Cloud_Improved_Version.Resources.isoPatch.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Winding-agnostic camera normal-side pass (tools/camera_norm_side.s @0x228F00): called by the
         town-camera cave at entry; flips gathered CCPoly normals to the ref's side. -->
    <EmbeddedResource Include="Resources\PNACH\A5C05C78.pnach">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Content Include="ModIcon.ico" />
    <AvaloniaResource Include="Resources\d06o_out_result.png" />
  </ItemGroup>
  <!-- The embedded stub binaries above are GENERATED from the EE cave stubs' .s files in tools/stubs. Editing a source
       without re-running its generator embeds stale bytes and fails SILENTLY, so the build regenerates them first. A missing
       assembler skips with a message rather than failing, which keeps a checkout without it buildable. -->
  <Target Name="RegenerateGeneratedResources" BeforeTargets="BeforeBuild">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/../tools/build_resources.py&quot;"
          StandardOutputImportance="high" />
  </Target>

</Project>
